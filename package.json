{
  "name": "shotcaller-final-release",
  "version": "4.5.1",
  "private": true,
  "description": "Self-hosted Discord Shotcaller with party relays, whisper routing, music and bridge controls.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js",
