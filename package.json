  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.10",
    "discord.js": "^14.24.0",
    "dotenv": "^17.2.2",
    "prism-media": "^1.3.5"
  }
}
