# ============================
# REQUIRED
# ============================
MAIN_BOT_TOKEN=
CLIENT_ID=

# One relay bot token per PARTY, including the shotcaller's own party (a relay sits in every party,
# yours too). So a 4-party session needs 4 relay tokens. 12 max.
# Example:
# RELAY_BOT_TOKENS=token1,token2,token3,...
RELAY_BOT_TOKENS=

# ============================
# OPTIONAL
# ============================
# Use a guild ID during setup/testing for instant slash-command updates.
DEV_GUILD_ID=

SHOTCALLER_ROLE_NAME=Shotcaller
OFFICER_ROLE_NAME=Officer
LEADER_ROLE_NAME=Leader
PARTY_CATEGORY_NAME=Shotcaller Parties

# Partner guild mapping. The two guilds must both run this application
# and each relay bot must be invited to both guilds.
# Example:
# BRIDGE_PARTNERS=111111111111111111=222222222222222222,222222222222222222=111111111111111111
BRIDGE_PARTNERS=

# HTTP health endpoint.
PORT=8787

# How long a whisper must be silent before its stream is ended.
WHISPER_SILENCE_MS=700

# How long an additional caller's callout stays open before closing itself (milliseconds).
CALLOUT_AUTO_OFF_MS=20000
