# ============================================================
# REQUIRED
# ============================================================

# Token for the main (shotcaller) Discord bot application.
MAIN_BOT_TOKEN=

# Application/client ID of the main bot (used to register slash commands).
CLIENT_ID=

# Comma-separated list of relay bot tokens — one per party channel, up to 12.
# Example: RELAY_BOT_TOKENS=tokenA,tokenB,tokenC
RELAY_BOT_TOKENS=

# ============================================================
# OPTIONAL — Role & channel names (defaults shown)
# ============================================================

# Slash-command updates are instant when DEV_GUILD_ID is set (development only).
# Remove or leave empty for global command registration in production.
DEV_GUILD_ID=

# Discord role names the bot will create/look up.
SHOTCALLER_ROLE_NAME=Shotcaller
OFFICER_ROLE_NAME=Officer
LEADER_ROLE_NAME=Leader
WHISPER_ROLE_NAME=Whisper

# Category name under which party channels are created/deleted.
PARTY_CATEGORY_NAME=Shotcaller Parties

# ============================================================
# BRIDGE (cross-guild)
# ============================================================
# Map this guild's ID → partner guild's ID (and vice-versa on the partner).
# Both guilds must run this application; relay bots must be in both guilds.
# Example:
# BRIDGE_PARTNERS=111111111111111111=222222222222222222,222222222222222222=111111111111111111
BRIDGE_PARTNERS=

# ============================================================
# TUNING
# ============================================================

# Port for the HTTP health endpoint (GET /health).
PORT=8787

# Milliseconds of silence before a whisper audio stream is closed.
WHISPER_SILENCE_MS=700
